FROM nvidia/cuopt@sha256:0faac7182b32f5be747e30f081427e80e8dfeccd8f49613814d3d217167fe1ad

ARG SOURCE_COMMIT=unfrozen
LABEL org.opencontainers.image.source="https://github.com/thomas-digregorio/activsg-gpu-scopf-spark"
LABEL org.opencontainers.image.revision="${SOURCE_COMMIT}"

ENV ACTIVSG_CUOPT_IMAGE="nvidia/cuopt@sha256:0faac7182b32f5be747e30f081427e80e8dfeccd8f49613814d3d217167fe1ad"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

WORKDIR /workspace
COPY pyproject.toml README.md NOTICE.md ./
COPY src ./src
RUN python -m pip install --no-cache-dir --no-deps .

ENTRYPOINT ["activsg-scopf"]

